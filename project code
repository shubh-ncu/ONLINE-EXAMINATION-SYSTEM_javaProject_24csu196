    static User login() {
        String u = readLine("Username: ");
        String p = readLine("Password: ");
        int idx = findUserIndexByUsername(u);
        if (idx == -1) return null;
        if (!users[idx].password.equals(p)) return null;
        return users[idx];
    }

    // Teacher flows
    static void createExamFlow(int teacherId) {
        String title = readLine("Title: ");
        String desc = readLine("Description: ");
        int dur = readInt("Duration (minutes): ");
        Exam e = new Exam();
        e.id = nextExamId++;
        e.ownerTeacherId = teacherId;
        e.title = title;
        e.description = desc;
        e.durationMinutes = dur;
        e.published = false;
        addExam(e);
        println("Created exam with ID: " + e.id);
    }

    static void addQuestionsFlow(int teacherId) {
        int examId = readInt("Exam ID: ");
        int exIdx = findExamIndexById(examId);
        if (exIdx == -1) { println("Exam not found."); return; }
        if (exams[exIdx].ownerTeacherId != teacherId) { println("Not your exam."); return; }
        while (true) {
            println("\nAdd Question:");
            println("1) Single Choice");
            println("2) Multi Choice");
            println("3) True/False");
            println("4) Subjective");
            println("5) Done");
            int c = readInt("Choose: ");
            if (c == 5) break;
            String text = readLine("Question text: ");
            double pts = readDouble("Points: ");
            Question q = new Question();
            q.id = nextQuestionId++;
            q.text = text;
            q.points = pts;

            if (c == 1) {
                q.type = Q_SINGLE;
                int n = readInt("How many choices (max " + MAX_CHOICES + "): ");
                if (n > MAX_CHOICES) n = MAX_CHOICES;
                int i = 0;
                while (i < n) {
                    q.choices[i] = readLine("Choice " + (i + 1) + ": ");
                    i++;
                }
                q.choiceCount = n;
                q.correctIndex = readInt("Correct choice number (1-" + n + "): ") - 1;
            } else if (c == 2) {
                q.type = Q_MULTI;
                int n = readInt("How many choices (max " + MAX_CHOICES + "): ");
                if (n > MAX_CHOICES) n = MAX_CHOICES;
                int i = 0;
                while (i < n) {
                    q.choices[i] = readLine("Choice " + (i + 1) + ": ");
                    i++;
                }
                q.choiceCount = n;
                int totalCorrect = readInt("How many correct options? ");
                if (totalCorrect > n) totalCorrect = n;
                int j = 0;
                while (j < totalCorrect) {
                    int idx = readInt("Enter correct option number (" + (j + 1) + " of " + totalCorrect + "): ") - 1;
                    if (idx >= 0 && idx < n) {
                        q.correctIndexes[q.correctIdxCount++] = idx;
                        j++;
                    } else {
                        println("Invalid index, try again.");
                    }
                }
            } else if (c == 3) {
                q.type = Q_TRUE_FALSE;
                String tf = readLine("Correct answer (T/F): ");
                q.correctTrue = tf.equalsIgnoreCase("T");
            } else if (c == 4) {
                q.type = Q_SUBJECTIVE;
            } else {
                println("Invalid type.");
                continue;
            }

            if (exams[exIdx].qCount >= MAX_QUESTIONS_PER_EXAM) {
                println("Max questions reached for this exam.");
                break;
            }
            exams[exIdx].questions[exams[exIdx].qCount++] = q;
            println("Question added (ID " + q.id + ").");
        }
    }

    static void publishExamFlow(int teacherId) {
        int examId = readInt("Exam ID: ");
        int exIdx = findExamIndexById(examId);
        if (exIdx == -1) { println("Exam not found."); return; }
        if (exams[exIdx].ownerTeacherId != teacherId) { println("Not your exam."); return; }
        if (exams[exIdx].qCount == 0) { println("Cannot publish empty exam."); return; }
        exams[exIdx].published = true;
        println("Exam published.");
    }

    static void assignExamFlow(int teacherId) {
        int examId = readInt("Exam ID: ");
        int exIdx = findExamIndexById(examId);
        if (exIdx == -1) { println("Exam not found."); return; }
        if (exams[exIdx].ownerTeacherId != teacherId) { println("Not your exam."); return; }
        if (!exams[exIdx].published) { println("Publish exam first."); return; }

        String stuUsername = readLine("Student username: ");
        int uIdx = findUserIndexByUsername(stuUsername);
        if (uIdx == -1 || users[uIdx].role != ROLE_STUDENT) { println("Student not found."); return; }

        if (isStudentAssignedToExam(exams[exIdx], users[uIdx].id)) {
            println("Already assigned.");
            return;
        }
        if (exams[exIdx].assignedCount >= MAX_ASSIGN) {
            println("Assignment list full.");
            return;
        }
        exams[exIdx].assignedStudentIds[exams[exIdx].assignedCount++] = users[uIdx].id;
        println("Assigned.");
    }

    static void manualGradeFlow() {
        int sessionId = readInt("Session ID: ");
        int sIdx = findSessionIndexById(sessionId);
        if (sIdx == -1) { println("Session not found."); return; }
        ExamSession s = sessions[sIdx];
        int exIdx = findExamIndexById(s.examId);
        if (exIdx == -1) { println("Exam not found."); return; }
        Exam e = exams[exIdx];

        double added = 0;
        int i = 0;
        while (i < e.qCount) {
            Question q = e.questions[i];
            if (q.type == Q_SUBJECTIVE) {
                Answer a = findAnswerForQuestion(s, q.id);
                println("\nSubjective Q: " + q.text + " (" + q.points + " pts)");
                if (a == null || a.textAnswer == null) {
                    println("No answer.");
                } else {
                    println("Student answer: " + a.textAnswer);
                }
                double sc = readDouble("Score to award (0-" + q.points + "): ");
                if (sc < 0) sc = 0;
                if (sc > q.points) sc = q.points;
                if (a != null) a.score += sc;
                added += sc;
            }
            i++;
        }
        Grade g = getOrCreateGrade(s.id);
        g.manualScore += added;
        println("Manual score added: " + added + ". Total now: " + (g.autoScore + g.manualScore));
    }

    static void analyticsFlow(int teacherId) {
        int examId = readInt("Exam ID: ");
        int exIdx = findExamIndexById(examId);
        if (exIdx == -1) { println("Exam not found."); return; }
        if (exams[exIdx].ownerTeacherId != teacherId) { println("Not your exam."); return; }
        Exam e = exams[exIdx];

        // Summary
        int attempts = 0;
        double sum = 0;
        double min = 1e18;
        double max = -1e18;

        int si = 0;
        while (si < sessionCount) {
            ExamSession s = sessions[si];
            if (s.examId == e.id && s.status != STATUS_ACTIVE) {
                Grade g = findGradeBySessionId(s.id);
                double total = (g == null) ? 0 : (g.autoScore + g.manualScore);
                attempts++;
                sum += total;
                if (total < min) min = total;
                if (total > max) max = total;
            }
            si++;
        }
        if (attempts == 0) {
            println("No attempts yet.");
        } else {
            double avg = sum / attempts;
            println("\n--- Exam Summary ---");
            println("Exam: " + e.title + " (ID " + e.id + ")");
            println("Total points: " + e.totalPoints());
            println("Attempts: " + attempts + " | Avg: " + round2(avg) + " | Min: " + round2(min) + " | Max: " + round2(max));
        }

        // Item analysis (objective only)
        println("\n--- Item Analysis ---");
        int qi = 0;
        while (qi < e.qCount) {
            Question q = e.questions[qi];
            if (q.type == Q_SUBJECTIVE) {
                println("Q" + q.id + " [Subjective]: N/A");
                qi++;
                continue;
            }
            int correct = 0;
            int answered = 0;
            int sj = 0;
            while (sj < sessionCount) {
                ExamSession s = sessions[sj];
                if (s.examId == e.id && s.status != STATUS_ACTIVE) {
                    Answer a = findAnswerForQuestion(s, q.id);
                    if (a != null) {
                        answered++;
                        if (isAnswerCorrect(q, a)) correct++;
                    }
                }
                sj++;
            }
            double p = answered == 0 ? 0 : (correct * 1.0 / answered);
            println("Q" + q.id + " [" + q.typeName() + "]: P(correct)=" + round2(p));
            qi++;
        }
    }

