import java.util.Scanner;

public class OnlineExaminationSystem {

    // Constants
    static final int ROLE_STUDENT = 1;
    static final int ROLE_TEACHER = 2;
    static final int ROLE_ADMIN = 3;

    static final int Q_SINGLE = 1;      // Single-choice
    static final int Q_MULTI = 2;       // Multi-select MCQ
    static final int Q_TRUE_FALSE = 3;  // True/False
    static final int Q_SUBJECTIVE = 4;  // Subjective (manual grading)

    static final int STATUS_ACTIVE = 1;
    static final int STATUS_SUBMITTED = 2;
    static final int STATUS_TIMEOUT = 3;

    static final int MAX_USERS = 200;
    static final int MAX_EXAMS = 200;
    static final int MAX_QUESTIONS_PER_EXAM = 100;
    static final int MAX_CHOICES = 10;
    static final int MAX_ASSIGN = 200;
    static final int MAX_SESSIONS = 1000;
    static final int MAX_GRADES = 1000;
    static final int MAX_ANSWERS_PER_SESSION = 100;

    // Data storage
    static User[] users = new User[MAX_USERS];
    static int userCount = 0;

    static Exam[] exams = new Exam[MAX_EXAMS];
    static int examCount = 0;

    static ExamSession[] sessions = new ExamSession[MAX_SESSIONS];
    static int sessionCount = 0;

    static Grade[] grades = new Grade[MAX_GRADES];
    static int gradeCount = 0;

    static int nextUserId = 1;
    static int nextExamId = 1;
    static int nextQuestionId = 1;
    static int nextSessionId = 1;

    static Scanner sc = new Scanner(System.in);

    // Data classes (simple, using basic syntax)
    static class User {
        int id;
        String username;
        String fullName;
        String password;
        int role;

        User(int id, String username, String fullName, String password, int role) {
            this.id = id;
            this.username = username;
            this.fullName = fullName;
            this.password = password;
            this.role = role;
        }

        public String roleName() {
            if (role == ROLE_STUDENT) return "STUDENT";
            if (role == ROLE_TEACHER) return "TEACHER";
            return "ADMIN";
        }

        public String toString() {
            return id + " | " + username + " | " + fullName + " | " + roleName();
        }
    }

    static class Exam {
        int id;
        int ownerTeacherId;
        String title;
        String description;
        int durationMinutes;
        boolean published;

        Question[] questions = new Question[MAX_QUESTIONS_PER_EXAM];
        int qCount = 0;

        int[] assignedStudentIds = new int[MAX_ASSIGN];
        int assignedCount = 0;

        double totalPoints() {
            double sum = 0;
            int i = 0;
            while (i < qCount) {
                sum += questions[i].points;
                i++;
            }
            return sum;
        }

        public String toString() {
            return "Exam " + id + " | " + title + " | dur=" + durationMinutes + "m | published=" + published + " | points=" + totalPoints();
        }
    }

    static class Question {
        int id;
        int type;
        String text;
        double points;

        // For MCQ
        String[] choices = new String[MAX_CHOICES];
        int choiceCount = 0;

        // For single-choice
        int correctIndex = -1;

        // For multi-select
        int[] correctIndexes = new int[MAX_CHOICES];
        int correctIdxCount = 0;

        // For true/false
        boolean correctTrue;

        public String typeName() {
            if (type == Q_SINGLE) return "Single Choice";
            if (type == Q_MULTI) return "Multi Choice";
            if (type == Q_TRUE_FALSE) return "True/False";
            return "Subjective";
        }

        public String toString() {
            return "Q" + id + " [" + typeName() + "] (" + points + " pts) " + text;
        }
    }

    static class Answer {
        int questionId;
        int[] selectedIndexes = new int[MAX_CHOICES];
        int selectedCount = 0;
        String textAnswer;
        double score;
    }

    static class ExamSession {
        int id;
        int examId;
        int studentId;
        long startedAtMillis;
        long expiresAtMillis;
        int status;

        Answer[] answers = new Answer[MAX_ANSWERS_PER_SESSION];
        int ansCount = 0;

        public String toString() {
            return "Session " + id + " | exam=" + examId + " | student=" + studentId + " | status=" + statusName();
        }

        String statusName() {
            if (status == STATUS_ACTIVE) return "ACTIVE";
            if (status == STATUS_SUBMITTED) return "SUBMITTED";
            return "TIMEOUT";
        }
    }

    static class Grade {
        int sessionId;
        double autoScore;
        double manualScore;

        public String toString() {
            return "Grade{session=" + sessionId + ", auto=" + autoScore + ", manual=" + manualScore + ", total=" + (autoScore + manualScore) + "}";
        }
    }

