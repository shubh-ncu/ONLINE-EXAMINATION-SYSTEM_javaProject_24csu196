    static void startAndTakeExamFlow(int studentId) {
        int examId = readInt("Exam ID: ");
        int exIdx = findExamIndexById(examId);
        if (exIdx == -1) { println("Exam not found."); return; }
        Exam e = exams[exIdx];
        if (!e.published) { println("Exam not published."); return; }
        if (!isStudentAssignedToExam(e, studentId)) { println("Not assigned to you."); return; }
        if (hasSubmittedSession(studentId, e.id)) {
            println("You already took this exam.");
            return;
        }

        ExamSession s = new ExamSession();
        s.id = nextSessionId++;
        s.examId = e.id;
        s.studentId = studentId;
        s.startedAtMillis = System.currentTimeMillis();
        s.expiresAtMillis = s.startedAtMillis + e.durationMinutes * 60L * 1000L;
        s.status = STATUS_ACTIVE;

        addSession(s);
        println("\nStarting exam: " + e.title + " | Duration: " + e.durationMinutes + " minutes");
        println("Total points: " + e.totalPoints());

        int i = 0;
        while (i < e.qCount) {
            if (System.currentTimeMillis() > s.expiresAtMillis) {
                s.status = STATUS_TIMEOUT;
                println("\nTime is up! Auto-submitting.");
                break;
            }
            Question q = e.questions[i];
            println("\nQ" + (i + 1) + ": (" + q.points + " pts) " + q.text);
            Answer a = new Answer();
            a.questionId = q.id;

            if (q.type == Q_SINGLE) {
                int j = 0;
                while (j < q.choiceCount) {
                    println((j + 1) + ") " + q.choices[j]);
                    j++;
                }
                int pick = readInt("Pick one (1-" + q.choiceCount + "): ") - 1;
                if (pick < 0) pick = 0;
                if (pick >= q.choiceCount) pick = q.choiceCount - 1;
                a.selectedIndexes[a.selectedCount++] = pick;
            } else if (q.type == Q_MULTI) {
                int j = 0;
                while (j < q.choiceCount) {
                    println((j + 1) + ") " + q.choices[j]);
                    j++;
                }
                String line = readLine("Pick multiple (comma-separated, e.g., 1,3): ").trim();
                if (line.length() > 0) {
                    String[] parts = line.split(",");
                    int k = 0;
                    while (k < parts.length && k < MAX_CHOICES) {
                        String t = parts[k].trim();
                        if (t.length() > 0) {
                            try {
                                int p = Integer.parseInt(t) - 1;
                                if (p >= 0 && p < q.choiceCount) {
                                    a.selectedIndexes[a.selectedCount++] = p;
                                }
                            } catch (Exception ex) {
                                // ignore parse errors
                            }
                        }
                        k++;
                    }
                }
            } else if (q.type == Q_TRUE_FALSE) {
                String tf = readLine("Answer (T/F): ");
                int val = tf.equalsIgnoreCase("T") ? 1 : 0;
                a.selectedIndexes[a.selectedCount++] = val;
            } else if (q.type == Q_SUBJECTIVE) {
                a.textAnswer = readLine("Your answer: ");
            }

            s.answers[s.ansCount++] = a;
            i++;
        }

        if (s.status == STATUS_ACTIVE) s.status = STATUS_SUBMITTED;

        // Auto-grade
        double autoScore = 0;
        int qi = 0;
        while (qi < e.qCount) {
            Question q = e.questions[qi];
            Answer a = findAnswerForQuestion(s, q.id);
            if (a != null) {
                double sc = autoGrade(q, a);
                a.score = sc;
                autoScore += sc;
            }
            qi++;
        }
        Grade g = getOrCreateGrade(s.id);
        g.autoScore = autoScore;

        println("\nSubmitted! Auto-score: " + autoScore + " / " + e.totalPoints());
        println("Session ID: " + s.id + " (note this for subjective manual grading by teacher)");
    }

    static void viewMyGrades(int studentId) {
        boolean any = false;
        int i = 0;
        while (i < sessionCount) {
            ExamSession s = sessions[i];
            if (s.studentId == studentId && s.status != STATUS_ACTIVE) {
                Grade g = findGradeBySessionId(s.id);
                Exam e = findExamById(s.examId);
                double total = (g == null) ? 0 : (g.autoScore + g.manualScore);
                println("Session " + s.id + " | Exam: " + (e == null ? s.examId : e.title) + " | Total: " + total);
                any = true;
            }
            i++;
        }
        if (!any) println("No grades yet.");
    }

    // Helpers: correctness, grading, searches
    static boolean isAnswerCorrect(Question q, Answer a) {
        if (q.type == Q_SINGLE) {
            if (a.selectedCount != 1) return false;
            return a.selectedIndexes[0] == q.correctIndex;
        } else if (q.type == Q_MULTI) {
            if (a.selectedCount != q.correctIdxCount) return false;
            int i = 0;
            while (i < a.selectedCount) {
                int sel = a.selectedIndexes[i];
                boolean found = false;
                int j = 0;
                while (j < q.correctIdxCount) {
                    if (q.correctIndexes[j] == sel) { found = true; break; }
                    j++;
                }
                if (!found) return false;
                i++;
            }
            return true;
        } else if (q.type == Q_TRUE_FALSE) {
            if (a.selectedCount == 0) return false;
            boolean ansTrue = a.selectedIndexes[0] == 1;
            return ansTrue == q.correctTrue;
        } else {
            return false;
        }
    }

    static double autoGrade(Question q, Answer a) {
        if (q.type == Q_SUBJECTIVE) return 0;
        return isAnswerCorrect(q, a) ? q.points : 0;
    }

    static Answer findAnswerForQuestion(ExamSession s, int qid) {
        int i = 0;
        while (i < s.ansCount) {
            if (s.answers[i].questionId == qid) return s.answers[i];
            i++;
        }
        return null;
    }

    static boolean isStudentAssignedToExam(Exam e, int studentId) {
        int i = 0;
        while (i < e.assignedCount) {
            if (e.assignedStudentIds[i] == studentId) return true;
            i++;
        }
        return false;
    }

    static boolean hasSubmittedSession(int studentId, int examId) {
        int i = 0;
        while (i < sessionCount) {
            ExamSession s = sessions[i];
            if (s.studentId == studentId && s.examId == examId && s.status != STATUS_ACTIVE) return true;
            i++;
        }
        return false;
    }

    static int findUserIndexByUsername(String username) {
        int i = 0;
        while (i < userCount) {
            if (users[i].username.equals(username)) return i;
            i++;
        }
        return -1;
    }

    static int findExamIndexById(int id) {
        int i = 0;
        while (i < examCount) {
            if (exams[i].id == id) return i;
            i++;
        }
        return -1;
    }

    static Exam findExamById(int id) {
        int idx = findExamIndexById(id);
        if (idx == -1) return null;
        return exams[idx];
    }

    static int findSessionIndexById(int id) {
        int i = 0;
        while (i < sessionCount) {
            if (sessions[i].id == id) return i;
            i++;
        }
        return -1;
    }

    static Grade findGradeBySessionId(int sid) {
        int i = 0;
        while (i < gradeCount) {
            if (grades[i].sessionId == sid) return grades[i];
            i++;
        }
        return null;
    }

    static Grade getOrCreateGrade(int sid) {
        Grade g = findGradeBySessionId(sid);
        if (g != null) return g;
        g = new Grade();
        g.sessionId = sid;
        g.autoScore = 0;
        g.manualScore = 0;
        addGrade(g);
        return g;
    }

    static void addUser(User u) {
        if (userCount < MAX_USERS) users[userCount++] = u;
    }

    static void addExam(Exam e) {
        if (examCount < MAX_EXAMS) exams[examCount++] = e;
    }

    static void addSession(ExamSession s) {
        if (sessionCount < MAX_SESSIONS) sessions[sessionCount++] = s;
    }

    static void addGrade(Grade g) {
        if (gradeCount < MAX_GRADES) grades[gradeCount++] = g;
    }

    static void listAllExams() {
        int i = 0;
        while (i < examCount) {
            println(exams[i].toString());
            i++;
        }
    }

    static void listExamsByTeacher(int teacherId) {
        int i = 0;
        boolean any = false;
        while (i < examCount) {
            if (exams[i].ownerTeacherId == teacherId) {
                println(exams[i].toString());
                any = true;
            }
            i++;
        }
        if (!any) println("No exams yet.");
    }

    // IO helpers (basic)
    static String readLine(String prompt) {
        System.out.print(prompt);
        return sc.nextLine();
    }

    static int readInt(String prompt) {
        while (true) {
            try {
                String s = readLine(prompt).trim();
                return Integer.parseInt(s);
            } catch (Exception e) {
                println("Enter an integer.");
            }
        }
    }

    static double readDouble(String prompt) {
        while (true) {
            try {
                String s = readLine(prompt).trim();
                return Double.parseDouble(s);
            } catch (Exception e) {
                println("Enter a number.");
            }
        }
    }

    static void println(String s) {
        System.out.println(s);
    }

    static String round2(double d) {
        long x = Math.round(d * 100);
        return "" + (x / 100.0);
    }
