            actionBox.setRenderer(new BasicComboBoxRenderer() {
                @Override
                public Component getListCellRendererComponent(JList list, Object value, int index, boolean isSelected, boolean cellHasFocus) {
                    Component c = super.getListCellRendererComponent(list, value, index, isSelected, cellHasFocus);
                    if (index == 0) setForeground(MUTED);
                    return c;
                }
            });
            goBtn.addActionListener(e -> switchAction());

            boxRow.add(actionLbl);
            boxRow.add(actionBox);
            boxRow.add(goBtn);

            launcher.add(boxRow, BorderLayout.CENTER);
            add(launcher, BorderLayout.SOUTH);

            // Content
            content.setBackground(BG);
            content.add(new JPanel(), "empty");
            content.add(adminPanel, "admin");
            content.add(teacherPanel, "teacher");
            content.add(studentPanel, "student");
            add(content, BorderLayout.CENTER);
        }

        void setUser(User u) {
            userInfo.setText(u.fullName + " (" + u.username + ", " + u.roleName() + ")");
            actionBox.removeAllItems();
            actionBox.addItem("— Select an action —");

            if (u.role == ROLE_ADMIN) {
                actionBox.addItem("List users");
                actionBox.addItem("Create exam (as teacher)");
                actionBox.addItem("List exams");
                ((CardLayout) content.getLayout()).show(content, "admin");
                adminPanel.refresh();
            } else if (u.role == ROLE_TEACHER) {
                actionBox.addItem("Create exam");
                actionBox.addItem("Add questions");
                actionBox.addItem("Publish exam");
                actionBox.addItem("Assign exam to student");
                actionBox.addItem("Manual grade subjective");
                actionBox.addItem("View analytics");
                actionBox.addItem("List my exams");
                ((CardLayout) content.getLayout()).show(content, "teacher");
                teacherPanel.setTeacher(u);
            } else {
                actionBox.addItem("List assigned exams");
                actionBox.addItem("Start/take exam");
                actionBox.addItem("View my grades");
                ((CardLayout) content.getLayout()).show(content, "student");
                studentPanel.setStudent(u);
            }
            actionBox.setSelectedIndex(0);
        }

        void switchAction() {
            String act = (String) actionBox.getSelectedItem();
            if (act == null || act.startsWith("—")) return;
            if (currentUser == null) return;

            if (currentUser.role == ROLE_ADMIN) {
                adminPanel.switchAction(act);
            } else if (currentUser.role == ROLE_TEACHER) {
                teacherPanel.switchAction(act);
            } else {
                studentPanel.switchAction(act);
            }
        }
    }

    // ========== Admin Panel ==========
    static class AdminPanel extends JPanel {
        CardLayout cards = new CardLayout();
        JPanel root = new JPanel(cards);

        DefaultTableModel usersModel = new DefaultTableModel(new String[]{"ID", "Username", "Full Name", "Role"}, 0);
        JTable usersTable = new JTable(usersModel);

        DefaultTableModel examsModel = new DefaultTableModel(new String[]{"ID", "Title", "Teacher", "Duration", "Published", "Points"}, 0);
        JTable examsTable = new JTable(examsModel);

        JComboBox<String> teacherBox = new JComboBox<>();
        JTextField titleField = new JTextField(22);
        JTextField descField = new JTextField(22);
        JSpinner durSpinner = new JSpinner(new SpinnerNumberModel(30, 1, 600, 1));

        AdminPanel() {
            setLayout(new BorderLayout());
            setBackground(BG);
            root.setBackground(BG);

            // List users
            JPanel listUsersCard = cardPanel("Users", "All registered accounts", new JScrollPane(usersTable));
            styleTable(usersTable);

            // Create exam (as teacher)
            JPanel createCardInner = new JPanel(new GridBagLayout());
            createCardInner.setBackground(CARD_BG);
            GridBagConstraints c = gbc();

            addRow(createCardInner, c, new JLabel("Teacher username"), teacherBox);
            addRow(createCardInner, c, new JLabel("Title"), titleField);
            addRow(createCardInner, c, new JLabel("Description"), descField);
            addRow(createCardInner, c, new JLabel("Duration (min)"), durSpinner);

            ModernButton createBtn = new ModernButton("Create Exam");
            createBtn.addActionListener(e -> {
                String tUser = (String) teacherBox.getSelectedItem();
                if (tUser == null) { err(this, "Pick a teacher"); return; }
                int idx = findUserIndexByUsername(tUser);
                if (idx == -1 || users[idx].role != ROLE_TEACHER) { err(this, "Teacher not found"); return; }
                String title = titleField.getText().trim();
                String desc = descField.getText().trim();
                int dur = (int) durSpinner.getValue();
                if (title.isEmpty()) { err(this, "Title required"); return; }

                Exam ex = new Exam();
                ex.id = nextExamId++;
                ex.ownerTeacherId = users[idx].id;
                ex.title = title;
                ex.description = desc;
                ex.durationMinutes = dur;
                ex.published = false;
                addExam(ex);
                msg(this, "Created exam ID " + ex.id);
                titleField.setText(""); descField.setText("");
            });
            c.gridx = 1; c.gridy++; c.anchor = GridBagConstraints.EAST;
            createCardInner.add(createBtn, c);

            JPanel createCard = cardPanel("Create Exam (as Teacher)", "Admin can create for any teacher", wrapPad(createCardInner));

            // List exams
            JPanel listExamsCard = cardPanel("Exams", "All exams in the system", new JScrollPane(examsTable));
            styleTable(examsTable);

