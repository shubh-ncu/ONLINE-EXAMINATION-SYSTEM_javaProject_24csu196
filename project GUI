        void setStudent(User s) {
            this.student = s;
            refreshAssigned();
            refreshGrades();
            refreshExamsToStart();
        }

        void switchAction(String act) {
            if (act.equals("List assigned exams")) { refreshAssigned(); cards.show(root, "assigned"); }
            else if (act.equals("Start/take exam")) { refreshExamsToStart(); cards.show(root, "start"); }
            else if (act.equals("View my grades")) { refreshGrades(); cards.show(root, "grades"); }
            else cards.show(root, "empty");
        }

        void refreshAssigned() {
            clearModel(assignedModel);
            if (student == null) return;
            for (int i = 0; i < examCount; i++) {
                Exam e = exams[i];
                if (e.published && isStudentAssignedToExam(e, student.id)) {
                    assignedModel.addRow(new Object[]{e.id, e.title, e.durationMinutes, e.totalPoints(), e.published});
                }
            }
        }

        void refreshExamsToStart() {
            examBoxStart.removeAllItems();
            if (student == null) return;
            for (int i = 0; i < examCount; i++) {
                Exam e = exams[i];
                if (e.published && isStudentAssignedToExam(e, student.id) && !hasSubmittedSession(student.id, e.id)) {
                    examBoxStart.addItem(e.id + " - " + e.title);
                }
            }
        }

        void refreshGrades() {
            clearModel(gradesModel);
            if (student == null) return;
            for (int i = 0; i < sessionCount; i++) {
                ExamSession s = sessions[i];
                if (s.studentId == student.id && s.status != STATUS_ACTIVE) {
                    Grade g = findGradeBySessionId(s.id);
                    Exam e = findExamById(s.examId);
                    double total = (g == null) ? 0 : (g.autoScore + g.manualScore);
                    gradesModel.addRow(new Object[]{s.id, e != null ? e.title : s.examId, total});
                }
            }
        }

        void startExam() {
            String sel = (String) examBoxStart.getSelectedItem();
            if (sel == null) { err(this, "Pick an exam"); return; }
            int exId = Integer.parseInt(sel.split("-")[0].trim());
            Exam e = findExamById(exId);
            if (e == null) { err(this, "Exam not found"); return; }

            if (!e.published || !isStudentAssignedToExam(e, student.id)) { err(this, "You cannot take this exam"); return; }
            if (hasSubmittedSession(student.id, e.id)) { err(this, "You already took this exam"); return; }

            ExamSession s = new ExamSession();
            s.id = nextSessionId++;
            s.examId = e.id;
            s.studentId = student.id;
            s.startedAtMillis = System.currentTimeMillis();
            s.expiresAtMillis = s.startedAtMillis + e.durationMinutes * 60L * 1000L;
            s.status = STATUS_ACTIVE;
            addSession(s);

            new ExamRunnerDialog(SwingUtilities.getWindowAncestor(this), e, s).setVisible(true);

            refreshGrades();
            refreshAssigned();
            refreshExamsToStart();
        }
    }

