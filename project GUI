    static void styleTable(JTable table) {
        table.setRowHeight(28);
        table.setShowVerticalLines(false);
        table.setIntercellSpacing(new Dimension(0, 1));
        table.setFillsViewportHeight(true);

        // Zebra striping
        DefaultTableCellRenderer zebra = new DefaultTableCellRenderer() {
            @Override
            public Component getTableCellRendererComponent(JTable tbl, Object val, boolean sel, boolean focus, int row, int col) {
                Component c = super.getTableCellRendererComponent(tbl, val, sel, focus, row, col);
                if (!sel) {
                    c.setBackground((row % 2 == 0) ? new Color(249, 250, 252) : Color.WHITE);
                } else {
                    c.setBackground(new Color(232, 240, 255));
                }
                return c;
            }
        };
        for (int i = 0; i < table.getColumnCount(); i++) {
            table.getColumnModel().getColumn(i).setCellRenderer(zebra);
        }

        JTableHeader header = table.getTableHeader();
        header.setReorderingAllowed(false);
        header.setBackground(new Color(243, 244, 246));
        header.setForeground(TEXT);
        header.setPreferredSize(new Dimension(header.getPreferredSize().width, 36));
        ((DefaultTableCellRenderer) header.getDefaultRenderer()).setHorizontalAlignment(SwingConstants.LEFT);
    }

    static class GradientHeader extends JPanel {
        JLabel title = new JLabel();
        JLabel subtitle = new JLabel();

        GradientHeader(String text, String sub) {
            setLayout(new BorderLayout());
            setBorder(new EmptyBorder(14, 18, 14, 18));
            title.setText(text);
            subtitle.setText(sub);
            title.setFont(new Font("Segoe UI", Font.BOLD, 18));
            subtitle.setFont(new Font("Segoe UI", Font.PLAIN, 12));
            title.setForeground(Color.WHITE);
            subtitle.setForeground(new Color(224, 231, 255));

            JPanel texts = new JPanel(new GridLayout(2, 1));
            texts.setOpaque(false);
            texts.add(title);
            texts.add(subtitle);

            add(texts, BorderLayout.WEST);
        }

        @Override
        protected void paintComponent(Graphics g) {
            super.paintComponent(g);
            Graphics2D g2 = (Graphics2D) g.create();
            g2.setRenderingHint(RenderingHints.KEY_ANTIALIASING, RenderingHints.VALUE_ANTIALIAS_ON);
            int w = getWidth(), h = getHeight();
            GradientPaint gp = new GradientPaint(0, 0, PRIMARY, w, h, PRIMARY_DARK);
            g2.setPaint(gp);
            g2.fillRect(0, 0, w, h);
            g2.dispose();
        }
    }

    static class ModernButton extends JButton {
        ModernButton(String text) {
            super(text);
            setFocusPainted(false);
            setContentAreaFilled(false);
            setOpaque(false);
            setForeground(Color.WHITE);
            setCursor(Cursor.getPredefinedCursor(Cursor.HAND_CURSOR));
            setBorder(new EmptyBorder(10, 16, 10, 16));
        }

        @Override
        protected void paintComponent(Graphics g) {
            Graphics2D g2 = (Graphics2D) g.create();
            g2.setRenderingHint(RenderingHints.KEY_ANTIALIASING, RenderingHints.VALUE_ANTIALIAS_ON);
            Shape r = new RoundRectangle2D.Double(0, 0, getWidth(), getHeight(), 12, 12);
            g2.setPaint(new GradientPaint(0, 0, PRIMARY, getWidth(), getHeight(), PRIMARY_DARK));
            g2.fill(r);
            g2.dispose();
            super.paintComponent(g);
        }
    }

    static JPanel cardPanel(String title, String subtitle, JComponent center) {
        JPanel outer = new JPanel(new BorderLayout());
        outer.setBackground(BG);
        GradientHeader header = new GradientHeader(title, subtitle);
        outer.add(header, BorderLayout.NORTH);

        JPanel card = new JPanel(new BorderLayout());
        card.setBorder(new EmptyBorder(16, 16, 16, 16));
        card.setBackground(CARD_BG);
        card.add(center, BorderLayout.CENTER);

        JPanel contentWrap = new JPanel(new BorderLayout());
        contentWrap.setBorder(new EmptyBorder(16, 16, 16, 16));
        contentWrap.setBackground(BG);
        contentWrap.add(card, BorderLayout.CENTER);

        outer.add(contentWrap, BorderLayout.CENTER);
        return outer;
    }

    static void msg(Component parent, String s) { JOptionPane.showMessageDialog(parent, s); }
    static void err(Component parent, String s) {
        JOptionPane.showMessageDialog(parent, s, "Error", JOptionPane.ERROR_MESSAGE);
    }

    // ========== Login Panel ==========
    static class LoginPanel extends JPanel {
        JTextField userField = new JTextField(18);
        JPasswordField passField = new JPasswordField(18);
        JComboBox<String> regRole = new JComboBox<>(new String[]{"Student", "Teacher"});
        JTextField regUser = new JTextField(18);
        JTextField regName = new JTextField(18);
        JPasswordField regPass = new JPasswordField(18);

        LoginPanel(AppFrame frame) {
            setLayout(new BorderLayout());
            setBackground(BG);

            GradientHeader header = new GradientHeader("Online Examination System", "Sign in or register to continue");
            add(header, BorderLayout.NORTH);

            JPanel center = new JPanel(new GridLayout(1, 2, 16, 16));
            center.setBackground(BG);
            center.setBorder(new EmptyBorder(16, 16, 16, 16));

            // Login card
            JPanel loginCard = new JPanel(new GridBagLayout());
            loginCard.setBackground(CARD_BG);
            loginCard.setBorder(new EmptyBorder(20, 20, 20, 20));
            GridBagConstraints c = gbc();

            JLabel lTitle = new JLabel("Login");
            lTitle.setFont(new Font("Segoe UI", Font.BOLD, 16));
            c.gridx = 0; c.gridy = 0; c.gridwidth = 2; c.anchor = GridBagConstraints.WEST; c.insets = new Insets(0,0,10,0);
            loginCard.add(lTitle, c);
            c.gridwidth = 1; c.insets = new Insets(5,5,5,5);

            c.gridy++; addRow(loginCard, c, new JLabel("Username"), userField);
            c.gridy++; addRow(loginCard, c, new JLabel("Password"), passField);

            ModernButton loginBtn = new ModernButton("Login");
            loginBtn.addActionListener(e -> {
                String u = userField.getText().trim();
                String p = new String(passField.getPassword());
                int idx = findUserIndexByUsername(u);
                if (idx == -1 || !users[idx].password.equals(p)) {
                    err(this, "Invalid credentials.");
                } else {
                    frame.onLogin(users[idx]);
                }
            });
            c.gridx = 1; c.gridy++; c.anchor = GridBagConstraints.EAST;
            loginCard.add(loginBtn, c);

            // Register card
            JPanel regCard = new JPanel(new GridBagLayout());
            regCard.setBackground(CARD_BG);
            regCard.setBorder(new EmptyBorder(20, 20, 20, 20));
            GridBagConstraints d = gbc();
            JLabel rTitle = new JLabel("Register");
            rTitle.setFont(new Font("Segoe UI", Font.BOLD, 16));
            d.gridx = 0; d.gridy = 0; d.gridwidth = 2; d.anchor = GridBagConstraints.WEST; d.insets = new Insets(0,0,10,0);
            regCard.add(rTitle, d);
            d.gridwidth = 1; d.insets = new Insets(5,5,5,5);

            d.gridy++; addRow(regCard, d, new JLabel("Role"), regRole);
            d.gridy++; addRow(regCard, d, new JLabel("Username"), regUser);
            d.gridy++; addRow(regCard, d, new JLabel("Full name"), regName);
            d.gridy++; addRow(regCard, d, new JLabel("Password"), regPass);

            ModernButton regBtn = new ModernButton("Create Account");
            regBtn.addActionListener(e -> {
                String u = regUser.getText().trim();
                String n = regName.getText().trim();
                String p = new String(regPass.getPassword());
                if (u.isEmpty() || n.isEmpty() || p.isEmpty()) {
                    err(this, "Please fill all fields."); return;
                }
                if (findUserIndexByUsername(u) != -1) {
                    err(this, "Username already exists."); return;
                }
                int role = regRole.getSelectedIndex() == 0 ? ROLE_STUDENT : ROLE_TEACHER;
                addUser(new User(nextUserId++, u, n, p, role));
                msg(this, "Registered!");
                regUser.setText(""); regName.setText(""); regPass.setText("");
            });
            d.gridx = 1; d.gridy++; d.anchor = GridBagConstraints.EAST;
            regCard.add(regBtn, d);

            center.add(loginCard);
            center.add(regCard);

            add(center, BorderLayout.CENTER);
        }

        private GridBagConstraints gbc() {
            GridBagConstraints c = new GridBagConstraints();
            c.insets = new Insets(6, 6, 6, 6);
            c.anchor = GridBagConstraints.EAST;
            c.gridx = 0; c.gridy = 0;
            return c;
        }

        private void addRow(JPanel p, GridBagConstraints c, JComponent l, JComponent f) {
            c.gridx = 0; p.add(l, c);
            c.gridx = 1; p.add(f, c);
        }
    }

