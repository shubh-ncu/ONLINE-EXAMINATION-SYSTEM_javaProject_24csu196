        void previewSubjectiveForSelectedSession() {
            String sel = sessionsList.getSelectedValue();
            if (sel == null) { subjectiveView.setText(""); return; }
            int sid = Integer.parseInt(sel.split("\\|")[0].trim());
            ExamSession s = findSessionById(sid);
            if (s == null) { subjectiveView.setText(""); return; }
            Exam ex = findExamById(s.examId);
            StringBuilder sb = new StringBuilder();
            sb.append("Session ").append(s.id).append("\n");
            for (int i = 0; i < ex.qCount; i++) {
                Question q = ex.questions[i];
                if (q.type == Q_SUBJECTIVE) {
                    Answer a = findAnswerForQuestion(s, q.id);
                    sb.append("Q").append(q.id).append(" (").append(q.points).append(" pts): ").append(q.text).append("\n");
                    sb.append("Ans: ").append(a != null && a.textAnswer != null ? a.textAnswer : "(no answer)").append("\n\n");
                }
            }
            Grade g = findGradeBySessionId(s.id);
            double total = g == null ? 0 : (g.autoScore + g.manualScore);
            sb.append("Current total: ").append(total).append("\n");
            subjectiveView.setText(sb.toString());
        }

        void openManualGradeDialog() {
            String sel = sessionsList.getSelectedValue();
            if (sel == null) { err(this, "Select a session"); return; }
            int sid = Integer.parseInt(sel.split("\\|")[0].trim());
            ExamSession s = findSessionById(sid);
            if (s == null) return;
            Exam ex = findExamById(s.examId);

            JPanel panel = new JPanel(new GridBagLayout());
            panel.setPreferredSize(new Dimension(720, 420));
            GridBagConstraints c = gbc();

            JSpinner[] spinners = new JSpinner[ex.qCount];
            int idx = 0;
            for (int i = 0; i < ex.qCount; i++) {
                Question q = ex.questions[i];
                if (q.type == Q_SUBJECTIVE) {
                    Answer a = findAnswerForQuestion(s, q.id);
                    String ansText = a != null && a.textAnswer != null ? a.textAnswer : "(no answer)";
                    JTextArea ta = new JTextArea(ansText, 3, 40);
                    ta.setLineWrap(true); ta.setWrapStyleWord(true); ta.setEditable(false);
                    addRow(panel, c, new JLabel("Q" + q.id + " (" + q.points + "): " + q.text), new JScrollPane(ta));
                    JSpinner sp = new JSpinner(new SpinnerNumberModel(0.0, 0.0, q.points, 0.5));
                    spinners[i] = sp;
                    addRow(panel, c, new JLabel("Score to award"), sp);
                    idx++;
                }
            }
            if (idx == 0) { msg(this, "No subjective questions"); return; }

            int res = JOptionPane.showConfirmDialog(this, panel, "Manual Grade", JOptionPane.OK_CANCEL_OPTION, JOptionPane.PLAIN_MESSAGE);
            if (res == JOptionPane.OK_OPTION) {
                double added = 0;
                for (int i = 0; i < ex.qCount; i++) {
                    Question q = ex.questions[i];
                    if (q.type == Q_SUBJECTIVE) {
                        Answer a = findAnswerForQuestion(s, q.id);
                        double sc = spinners[i] != null ? (double) spinners[i].getValue() : 0.0;
                        if (sc < 0) sc = 0;
                        if (sc > q.points) sc = q.points;
                        if (a != null) a.score += sc;
                        added += sc;
                    }
                }
                Grade g = getOrCreateGrade(s.id);
                g.manualScore += added;
                msg(this, "Manual score added: " + added + ". Total now: " + (g.autoScore + g.manualScore));
                previewSubjectiveForSelectedSession();
            }
        }

        void refreshAnalytics() {
            analyticsArea.setText("");
            Exam ex = getSelectedTeacherExam(examBoxAnalytics);
            if (ex == null) return;

            int attempts = 0;
            double sum = 0, min = 1e18, max = -1e18;

            for (int i = 0; i < sessionCount; i++) {
                ExamSession s = sessions[i];
                if (s.examId == ex.id && s.status != STATUS_ACTIVE) {
                    Grade g = findGradeBySessionId(s.id);
                    double total = (g == null) ? 0 : (g.autoScore + g.manualScore);
                    attempts++; sum += total; min = Math.min(min, total); max = Math.max(max, total);
                }
            }
            StringBuilder sb = new StringBuilder();
            sb.append("Exam: ").append(ex.title).append(" (ID ").append(ex.id).append(")\n");
            sb.append("Total points: ").append(ex.totalPoints()).append("\n");
            if (attempts == 0) sb.append("No attempts yet.\n");
            else sb.append("Attempts: ").append(attempts).append(" | Avg: ").append(round2(sum / attempts))
                    .append(" | Min: ").append(round2(min)).append(" | Max: ").append(round2(max)).append("\n");

            sb.append("\n--- Item Analysis (objective only) ---\n");
            for (int qi = 0; qi < ex.qCount; qi++) {
                Question q = ex.questions[qi];
                if (q.type == Q_SUBJECTIVE) { sb.append("Q").append(q.id).append(" [Subjective]: N/A\n"); continue; }
                int correct = 0, answered = 0;
                for (int sj = 0; sj < sessionCount; sj++) {
                    ExamSession s = sessions[sj];
                    if (s.examId == ex.id && s.status != STATUS_ACTIVE) {
                        Answer a = findAnswerForQuestion(s, q.id);
                        if (a != null) { answered++; if (isAnswerCorrect(q, a)) correct++; }
                    }
                }
                double p = answered == 0 ? 0 : (correct * 1.0 / answered);
                sb.append("Q").append(q.id).append(" [").append(q.typeName()).append("]: P(correct)=").append(round2(p)).append("\n");
            }
            analyticsArea.setText(sb.toString());
        }

        void refreshMyExams() {
            clearModel(myExamsModel);
            if (teacher == null) return;
            for (int i = 0; i < examCount; i++) {
                if (exams[i].ownerTeacherId == teacher.id) {
                    myExamsModel.addRow(new Object[]{exams[i].id, exams[i].title, exams[i].durationMinutes,
                            exams[i].published, exams[i].totalPoints()});
                }
            }
        }

        Exam getSelectedTeacherExam(JComboBox<String> cb) {
            String sel = (String) cb.getSelectedItem();
            if (sel == null || sel.trim().isEmpty()) return null;
            int id = Integer.parseInt(sel.split("-")[0].trim());
            return findExamById(id);
        }
    }

