        void doAddQuestion() {
            Exam ex = getSelectedTeacherExam(examBoxAQ);
            if (ex == null) { err(this, "Select exam"); return; }
            Question q = new Question();
            q.id = nextQuestionId++;
            q.text = qText.getText().trim();
            q.points = (double) qPts.getValue();
            if (q.text.isEmpty() || q.points < 0) { err(this, "Invalid question or points"); return; }
            String type = (String) qTypeBox.getSelectedItem();

            if (type.equals("Single Choice")) {
                q.type = Q_SINGLE;
                q.choiceCount = 0;
                for (int i = 0; i < 4; i++) {
                    String t = choiceFields[i].getText().trim();
                    if (!t.isEmpty()) q.choices[q.choiceCount++] = t;
                }
                int corr = -1;
                for (int i = 0; i < 4; i++) if (singleCorrect[i].isSelected()) corr = i;
                if (q.choiceCount == 0 || corr < 0 || corr >= q.choiceCount) { err(this, "Set choices and correct option"); return; }
                q.correctIndex = corr;
            } else if (type.equals("Multi Choice")) {
                q.type = Q_MULTI;
                q.choiceCount = 0; q.correctIdxCount = 0;
                for (int i = 0; i < 4; i++) {
                    String t = choiceFields[i].getText().trim();
                    if (!t.isEmpty()) {
                        q.choices[q.choiceCount] = t;
                        if (multiCorrect[i].isSelected()) q.correctIndexes[q.correctIdxCount++] = q.choiceCount;
                        q.choiceCount++;
                    }
                }
                if (q.choiceCount == 0 || q.correctIdxCount == 0) { err(this, "Set choices and at least one correct"); return; }
            } else if (type.equals("True/False")) {
                q.type = Q_TRUE_FALSE;
                if (!tfTrue.isSelected() && !tfFalse.isSelected()) { err(this, "Select True or False"); return; }
                q.correctTrue = tfTrue.isSelected();
            } else {
                q.type = Q_SUBJECTIVE;
            }

            if (ex.qCount >= MAX_QUESTIONS_PER_EXAM) { err(this, "Max questions reached"); return; }
            ex.questions[ex.qCount++] = q;

            qText.setText(""); qPts.setValue(1.0);
            for (int i = 0; i < 4; i++) { choiceFields[i].setText(""); singleCorrect[i].setSelected(false); multiCorrect[i].setSelected(false); }
            tfTrue.setSelected(false); tfFalse.setSelected(false);

            msg(this, "Question added (ID " + q.id + ")");
        }

        void doPublish() {
            Exam ex = getSelectedTeacherExam(examBoxPub);
            if (ex == null) { err(this, "Select exam"); return; }
            if (ex.qCount == 0) { err(this, "Cannot publish empty exam"); return; }
            ex.published = true;
            msg(this, "Published");
        }

        void doAssign() {
            Exam ex = getSelectedTeacherExam(examBoxAssign);
            if (ex == null || !ex.published) { err(this, "Select a published exam"); return; }
            String stuUser = (String) studentBoxAssign.getSelectedItem();
            if (stuUser == null) { err(this, "Select student"); return; }
            int idx = findUserIndexByUsername(stuUser);
            if (idx == -1 || users[idx].role != ROLE_STUDENT) { err(this, "Invalid student"); return; }

            if (isStudentAssignedToExam(ex, users[idx].id)) { err(this, "Already assigned"); return; }
            if (ex.assignedCount >= MAX_ASSIGN) { err(this, "Assignment list full"); return; }
            ex.assignedStudentIds[ex.assignedCount++] = users[idx].id;
            msg(this, "Assigned");
        }

