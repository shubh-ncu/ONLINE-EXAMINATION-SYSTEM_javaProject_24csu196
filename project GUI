    static void setBestLookAndFeel() {
        try {
            // Try FlatLaf (no compile-time dependency, use reflection)
            Class<?> lafClass = tryLoadClass("com.formdev.flatlaf.themes.FlatMacLightLaf");
            if (lafClass == null) lafClass = tryLoadClass("com.formdev.flatlaf.FlatLightLaf");
            if (lafClass != null) {
                Constructor<?> ctor = lafClass.getDeclaredConstructor();
                LookAndFeel laf = (LookAndFeel) ctor.newInstance();
                UIManager.setLookAndFeel(laf);
                tweakUIDefaults(true);
                return;
            }
        } catch (Exception ignored) {}

        // Nimbus fallback
        try {
            for (UIManager.LookAndFeelInfo info : UIManager.getInstalledLookAndFeels()) {
                if ("Nimbus".equals(info.getName())) {
                    UIManager.setLookAndFeel(info.getClassName());
                    tweakUIDefaults(false);
                    return;
                }
            }
        } catch (Exception ignored) {}

        try {
            UIManager.setLookAndFeel(UIManager.getSystemLookAndFeelClassName());
            tweakUIDefaults(false);
        } catch (Exception ignored) {}
    }

    static Class<?> tryLoadClass(String fqcn) {
        try { return Class.forName(fqcn); } catch (Throwable t) { return null; }
    }

